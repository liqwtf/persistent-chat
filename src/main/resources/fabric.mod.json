{
  "schemaVersion": 1,
  "name": "Persistent Chat",
  "id": "persistent-chat",
  "description": "${description}",
  "version": "${version}",
  "authors": [ "liqw" ],
  "contact": {
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "MIT",
  "icon": "assets/persistent-chat/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.liqw.persistentchat.PersistentChat"
    ],
    "client": [
      "dev.liqw.persistentchat.client.PersistentChatClient"
    ],
    "modmenu": [
      "dev.liqw.persistentchat.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "persistent-chat.mixins.json",
    {
      "config": "persistent-chat.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}"
  }
}